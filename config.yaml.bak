units:
  extra_spread: 0
  extra_padding: 0
  board_expand: 2

  # Physical measures
  screw_radius: 1.1 # M2 screws
  screw_diameter: screw_radius * 2
  screw_head_radius: 2.05
  screw_head_diameter: screw_head_radius * 2
  spacer_radius: 2.15 # M2 standoffs
  spacer_diameter: spacer_radius * 2
  fillet_radius: 0.5

  # Case variables
  case_wall_thickness: 1.2
  pcb_to_case_wall_tolerance: 0.25
  bottom_plate_thickness: 1.0
  top_plate_thickness: 1.6
  internal_distance_between_plates: 4
points:
  zones:
    # Main key matrix
    matrix:
      key:
        spread: u + extra_spread
        padding: u + extra_padding
        tags:
          - key
      anchor:
        shift: [100, -100] # Fix KiCad placement
      columns:
        c1.rows.r6:
          width: 2u
          adjust.shift: [0.5u, 0]
        c2:
          rows.r6:
            skip: true
        c3:
        c4.rows:
          r3:
            height: 2u
            adjust.shift: [0, -0.5u]
          r4.skip: true
          r5:
            height: 2u
            adjust.shift: [0, -0.5u]
          r6.skip: true
      rows:
        r6:
        r5:
        r4:
        r3:
        r2:
        r1:
    screw_pcb_left_top:
      key.tags:
        - helper
        - screw
      anchor:
        - ref: matrix_c1_r2
          shift: [(u + extra_spread) / 2, -(u + extra_padding) / 2]
    screw_pcb_right_top:
      key.tags:
        - helper
        - screw
      anchor:
        - ref: matrix_c4_r1
          shift: [-(u + extra_spread) / 2, -(u + extra_padding) / 2]
    screw_pcb_right_bottom:
      key.tags:
        - helper
        - screw
      anchor:
        - ref: matrix_c4_r6
          shift: [-(u + extra_spread) / 2, (u + extra_padding) / 2]
    screw_pcb_left_bottom:
      key.tags:
        - helper
        - screw
      anchor:
        - ref: matrix_c1_r6
          shift: [0, (u + extra_padding) / 2]
    screw_pcb_center:
      key.tags:
        - helper
        - screw
      anchor:
        - ref: matrix_c2_r3
          shift: [(u + extra_spread) / 2, -(u + extra_padding) / 2]
outlines:
  _keycaps:
    - what: rectangle
      where: [key]
      size: 18
      fillet: 1
  _switches:
    - what: rectangle
      where: [key]
      size: 14
  _screws:
    - what: circle
      where: /screw_pcb/
      radius: screw_radius
  _screw_heads:
    - what: circle
      where: /screw_pcb/
      radius: screw_head_radius
  _spacers:
    - what: circle
      where: /screw_pcb/
      radius: spacer_radius
  _matrix_outline:
    - what: polygon
      points:
        - ref: matrix_c1_r1
          shift: [-u/2, u/2]
        - ref: matrix_c4_r1
          shift: [u/2, u/2]
        - ref: matrix_c4_r5
          shift: [u/2, -u]
        - ref: matrix_c1_r6
          shift: [-u, -u/2]
  _board_outline:
    - what: outline
      name: _matrix_outline
      expand: board_expand

  not_about_money_outline:
    - what: outline
      name: _board_outline
    - what: outline
      name: _screws
      operation: stack

  _top_case_outer_outline:
    - what: outline
      name: _board_outline
      expand: case_wall_thickness + pcb_to_case_wall_tolerance
      fillet: 0.5
      joints: 1
  _top_case_inner_outline:
    - what: outline
      name: _board_outline
      expand: pcb_to_case_wall_tolerance
      fillet: 0.5
      joints: 1
  top_case_inner_plate:
    - what: outline
      name: _top_case_inner_outline
    - what: outline
      name: _switches
      operation: subtract
  _top_case_walls:
    - what: outline
      name: _top_case_outer_outline
    - what: outline
      name: _top_case_inner_outline
      operation: subtract

  _bottom_case_superlight_inner_outline:
    - what: outline
      name: _board_outline
      expand: -2 * case_wall_thickness
      fillet: 0.5
      joints: 1
  _bottom_case_outer_outline:
    - what: outline
      name: _board_outline
      expand: case_wall_thickness + pcb_to_case_wall_tolerance
      fillet: 0.5
      joints: 1
  _bottom_case_inner_outline:
    - what: outline
      name: _board_outline
      expand: pcb_to_case_wall_tolerance
      fillet: 0.5
      joints: 1
  _bottom_case_walls:
    - what: outline
      name: _bottom_case_outer_outline
    - what: outline
      name: _bottom_case_inner_outline
      operation: subtract

  preview:
    - what: outline
      name: _board_outline
    - what: outline
      name: _keycaps
      operation: stack
    - what: outline
      name: _screws
      operation: stack
    - what: outline
      name: _switches
      operation: stack
    - what: outline
      name: _screw_heads
      operation: stack
    - what: outline
      name: _top_case_walls
      operation: stack
    - what: outline
      name: _top_case_outer_outline
      operation: stack
pcbs:
  not_about_money:
    template: kicad8
    outlines:
      main:
        outline: _board_outline
    footprints:
      m2_screws:
        what: ceoloide/mounting_hole_npth
        where: /screw/
        params:
          hole_size: screw_diameter
          hole_drill: screw_diameter

      key_switches:
        what: ceoloide/switch_choc_v1_v2
        where: /key/
        params:
          side: B
          reversible: false
          hotswap: true
          include_corner_marks: false
          choc_v1_support: false
          from: "{{column_net}}"
          to: "{{colrow}}"

      diodes:
        what: ceoloide/diode_tht_sod123
        where: /key/
        params:
          from: "{{colrow}}"
          to: "{{row_net}}"
          include_tht: false
          reversible: false
          side: B
        adjust:
          shift: [7.1, 1.25]
          rotate: 90

      mcu:
        what: ceoloide/mcu_nice_nano
        where: matrix_c1_r1
        params:
          P21: C1
          P20: C2
          P19: C3
          P18: C4
          P15: C5
          P14: C6
          P16: R1
          P10: R2
          P7: R3
          P8: R4
          P1_label: " "
          P0_label: " "
          P2_label: " "
          P3_label: " "
          P4_label: " "
          P5_label: " "
          P6_label: " "
          P9_label: " "
          RAW_label: "B+"
          GND_label: "GN"
          RST_label: "RS"
          VCC_label: "V+"
          side: B
          show_silk_labels_on_both_sides: false
        adjust:
          rotate: 90
          shift: [u/2 -board_expand*2- 0.2, 1]

      on_off_switch:
        what: ceoloide/power_switch_smd_side
        where: matrix_c1_r2
        params:
          side: B
          from: BAT_P
          to: RAW
        adjust:
          shift: [-u/2 -board_expand + 1.8, -(u + extra_padding) / 2]
          rotate: 180

      reset_switch:
        what: ceoloide/reset_switch_smd_side
        where: matrix_c2_r1
        params:
          side: B
          from: GND
          to: RST
          include_bosses: true
        adjust:
          shift: [(u + extra_spread) / 2 + 4, u/2 + board_expand - 2.25]

      battery_connector:
        what: ceoloide/battery_connector_jst_ph_2
        where: matrix_c2_r2
        params:
          side: B
          BAT_P: BAT_P
          BAT_N: GND
          include_courtyard: false
        adjust:
          shift: [(u + extra_spread) / 2, -(u + extra_padding) / 2 + 1]
          rotate: 90

      jlcpcb_order_number_text:
        what: ceoloide/utility_text
        where: matrix_c3_r4
        params:
          side: B
          mirrored: true
          text: JLCJLCJLCJLC
        adjust:
          shift: [u/2, -5]

      board_version_text:
        what: ceoloide/utility_text
        where: matrix_c3_r2
        params:
          side: B
          mirrored: true
          text: "'Not about money' v0.1 by ceoloide"
        adjust:
          shift: [(u + extra_spread) / 2, -(u + extra_padding) / 2 + 4]
cases:
  case_top:
    - what: outline
      name: _top_case_walls
      extrude: (bottom_plate_thickness + internal_distance_between_plates + top_plate_thickness)
      shift: [0, 0, 0]
    - what: outline
      name: top_case_inner_plate
      extrude: -top_plate_thickness
      shift: [0, 0, 0]
