#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
    &kp ESC        &kp TAB         &kp BSPC          &mo 1
    &kp KP_NUMLOCK &kp KP_DIVIDE   &kp KP_MULTIPLY   &kp KP_MINUS
    &kp KP_N7      &kp KP_N8       &kp KP_N9         &kp KP_PLUS
    &kp KP_N4      &kp KP_N5       &kp KP_N6
    &kp KP_N1      &kp KP_N2       &kp KP_N3         &kp KP_ENTER
    &kp KP_N0                      &kp KP_DOT
            >;
        };

        /* hold the top-right key */
        fn {
            display-name = "Fn";
            bindings = <
    &bootloader    &sys_reset      &trans            &trans
    &bt BT_CLR     &trans          &trans            &out OUT_TOG
    &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2      &kp C_VOL_UP
    &kp C_PREV     &kp C_PP        &kp C_NEXT
    &bt BT_PRV     &bt BT_NXT      &kp C_MUTE        &kp C_VOL_DN
    &out OUT_USB                   &out OUT_BLE
            >;
        };
    };
};
